<Window x:Class="OS.Presentation.UI.Views.PatientDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Patient" 
        Height="550" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1a1a2e">
    
    <Border Background="#1e1e2e" CornerRadius="8" Margin="10">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <TextBlock x:Name="HeaderText" 
                      Text="New Patient" 
                      FontSize="22" 
                      FontWeight="Bold"
                      Margin="0,0,0,20"/>
            
            <!-- Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="FirstNameLabel" Text="First Name *" Margin="0,0,0,5"/>
                    <ui:TextBox x:Name="FirstNameTextBox" Margin="0,0,0,15"/>
                    
                    <TextBlock x:Name="LastNameLabel" Text="Last Name *" Margin="0,0,0,5"/>
                    <ui:TextBox x:Name="LastNameTextBox" Margin="0,0,0,15"/>
                    
                    <TextBlock x:Name="DOBLabel" Text="Date of Birth *" Margin="0,0,0,5"/>
                    <DatePicker x:Name="DOBPicker" Margin="0,0,0,15"/>
                    
                    <TextBlock x:Name="MRNLabel" Text="Medical Record Number" Margin="0,0,0,5"/>
                    <ui:TextBox x:Name="MRNTextBox" Margin="0,0,0,15"/>
                    
                    <TextBlock x:Name="PhoneLabel" Text="Phone" Margin="0,0,0,5"/>
                    <ui:TextBox x:Name="PhoneTextBox" Margin="0,0,0,15"/>
                    
                    <TextBlock x:Name="EmailLabel" Text="Email" Margin="0,0,0,5"/>
                    <ui:TextBox x:Name="EmailTextBox" Margin="0,0,0,15"/>
                    
                    <TextBlock x:Name="AddressLabel" Text="Address" Margin="0,0,0,5"/>
                    <ui:TextBox x:Name="AddressTextBox" 
                               AcceptsReturn="True" 
                               Height="60"
                               TextWrapping="Wrap"
                               Margin="0,0,0,15"/>
                    
                    <TextBlock x:Name="NotesLabel" Text="Notes" Margin="0,0,0,5"/>
                    <ui:TextBox x:Name="NotesTextBox" 
                               AcceptsReturn="True" 
                               Height="80"
                               TextWrapping="Wrap"
                               Margin="0,0,0,15"/>
                </StackPanel>
            </ScrollViewer>
            
            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <ui:Button x:Name="CancelButton" 
                          Content="Cancel" 
                          Margin="0,0,10,0"
                          Click="CancelButton_Click"/>
                <ui:Button x:Name="SaveButton" 
                          Content="Save" 
                          Appearance="Primary"
                          Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
