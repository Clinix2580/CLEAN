<Window x:Class="OS.Presentation.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="SoftwareOS - Login" 
        Height="600" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e">
    
    <Grid>
        <Border Background="#1e1e2e" 
                CornerRadius="12" 
                Padding="40"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Width="400">
            <StackPanel>
                <!-- Logo -->
                <ui:SymbolIcon Symbol="ShieldTask24" 
                              FontSize="48" 
                              Foreground="#4a9eff"
                              HorizontalAlignment="Center"/>
                
                <TextBlock Text="SoftwareOS" 
                          FontSize="24" 
                          FontWeight="Bold" 
                          Foreground="White"
                          HorizontalAlignment="Center"
                          Margin="0,15,0,5"/>
                
                <TextBlock x:Name="SubtitleText"
                          Text="Secure Healthcare &amp; Commerce Management"
                          FontSize="12" 
                          Foreground="#888888"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,30"/>
                
                <!-- Login Form -->
                <TextBlock x:Name="UsernameLabel"
                          Text="Usuario" 
                          Foreground="#aaaaaa" 
                          Margin="0,0,0,5"/>
                <ui:TextBox x:Name="UsernameTextBox"
                           PlaceholderText="Enter username"
                           Margin="0,0,0,15"/>
                
                <TextBlock x:Name="PasswordLabel"
                          Text="Contraseña" 
                          Foreground="#aaaaaa" 
                          Margin="0,0,0,5"/>
                <ui:PasswordBox x:Name="PasswordBox"
                                PlaceholderText="Enter password"
                                Margin="0,0,0,20"/>
                
                <!-- Error Message -->
                <TextBlock x:Name="ErrorText"
                          Foreground="#ff6b6b"
                          TextWrapping="Wrap"
                          Margin="0,0,0,15"
                          Visibility="Collapsed"/>
                
                <!-- Login Button -->
                <ui:Button x:Name="LoginButton"
                          Content="Iniciar Sesión"
                          Appearance="Primary"
                          HorizontalAlignment="Stretch"
                          Click="LoginButton_Click"/>
                
                <!-- Demo Warning -->
                <TextBlock x:Name="DemoWarning"
                          Text="⚠ Modo Demo: Solo lectura"
                          Foreground="#ffa500"
                          HorizontalAlignment="Center"
                          Margin="0,20,0,0"
                          Visibility="Collapsed"/>
                
                <!-- Compliance Badge -->
                <Border Background="#2d2d44" 
                        CornerRadius="4"
                        Padding="10"
                        Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock x:Name="ComplianceText"
                                  Text="HIPAA safeguards"
                                  Foreground="#4a9eff"
                                  FontSize="11"
                                  HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EncryptionText"
                                  Text="AES-256 Encryption | Hardware-Bound"
                                  Foreground="#666666"
                                  FontSize="10"
                                  HorizontalAlignment="Center"
                                  Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
