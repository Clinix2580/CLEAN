<Page x:Class="OS.Presentation.UI.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Settings">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock x:Name="HeaderText" 
                  Text="Settings" 
                  FontSize="28" 
                  FontWeight="Bold"
                  Margin="0,0,0,20"/>
        
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Compliance Section -->
                <ui:Card Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock x:Name="ComplianceHeader" 
                                  Text="Compliance &amp; Security" 
                                  FontSize="18" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,15"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,5,10,5">
                                <TextBlock x:Name="FrameworkLabel" Text="Compliance Framework" Opacity="0.7"/>
                                <TextBlock Text="{Binding ComplianceFramework}" FontWeight="SemiBold"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,5,0,5">
                                <TextBlock x:Name="LanguageLabel" Text="Language" Opacity="0.7"/>
                                <TextBlock Text="{Binding Language}" FontWeight="SemiBold"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,5,10,5">
                                <TextBlock x:Name="AutoLogoutLabel" Text="Auto-Logout (minutes)" Opacity="0.7"/>
                                <TextBlock Text="{Binding AutoLogoutMinutes}" FontWeight="SemiBold"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,5,0,5">
                                <TextBlock x:Name="EncryptionLabel" Text="Data Encryption" Opacity="0.7"/>
                                <TextBlock Text="AES-256 (Enabled)" FontWeight="SemiBold" Foreground="#4a9eff"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,5,10,5">
                                <TextBlock x:Name="AuditLabel" Text="Audit Logging" Opacity="0.7"/>
                                <TextBlock Text="{Binding AuditEnabled}" FontWeight="SemiBold"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,5,0,5">
                                <TextBlock x:Name="VersionLabel" Text="Privacy Notice Version" Opacity="0.7"/>
                                <TextBlock Text="{Binding PrivacyNoticeVersion}" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,5,10,5">
                                <TextBlock x:Name="LicenseLabel" Text="License Status" Opacity="0.7"/>
                                <TextBlock Text="{Binding LicenseStatus}" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="10,5,0,5">
                                <TextBlock x:Name="FingerprintLabel" Text="Machine Fingerprint" Opacity="0.7"/>
                                <TextBlock Text="{Binding MachineFingerprint}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5,0,5">
                                <TextBlock x:Name="LicenseReasonLabel" Text="License Message" Opacity="0.7"/>
                                <TextBlock Text="{Binding LicenseReason}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ui:Card>
                
                <!-- Legal Documents -->
                <ui:Card Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock x:Name="LegalHeader" 
                                  Text="Legal Documents" 
                                  FontSize="18" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,15"/>
                        
                        <StackPanel Orientation="Horizontal">
                            <ui:Button x:Name="PrivacyButton" 
                                      Content="View Privacy Notice" 
                                      Margin="0,0,10,0"
                                      Click="PrivacyButton_Click"/>
                            <ui:Button x:Name="EulaButton" 
                                      Content="View EULA" 
                                      Margin="0,0,10,0"
                                      Click="EulaButton_Click"/>
                            <ui:Button x:Name="DisclaimerButton"
                                      Content="View Disclaimer"
                                      Click="DisclaimerButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
                
                <!-- System Info -->
                <ui:Card>
                    <StackPanel>
                        <TextBlock x:Name="SystemHeader" 
                                  Text="System Information" 
                                  FontSize="18" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,15"/>
                        
                        <TextBlock x:Name="VersionInfo" 
                                  Text="SoftwareOS v1.0.0" 
                                  Opacity="0.7"/>
                        <TextBlock x:Name="BuildInfo" 
                                  Text="Build: AOT Native x64" 
                                  Opacity="0.7"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

