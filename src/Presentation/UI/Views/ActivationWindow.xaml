<Window x:Class="OS.Presentation.UI.Views.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="ClinicOS Activation"
        Height="560" Width="680"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">
    <Grid Margin="32">
        <Border Background="#1e1e2e" CornerRadius="10" Padding="28">
            <StackPanel>
                <ui:SymbolIcon Symbol="Key24"
                               FontSize="44"
                               Foreground="#4a9eff"
                               HorizontalAlignment="Center"/>

                <TextBlock x:Name="TitleText"
                           Text="Activacion requerida"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,8"/>

                <TextBlock x:Name="InstructionText"
                           Text="Otorga este numero al desarrollador o agente de venta para obtener tu licencia activada."
                           Foreground="#d0d0dc"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,8"/>

                <Border Background="#ff6b6b"
                        CornerRadius="6"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="⚠️ ADVERTENCIA IMPORTANTE"
                                   Foreground="#ffffff"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="ESTE PROGRAMA DEBE INSTALARSE Y ACTIVARSE EN EL EQUIPO QUE OPERA EL SERVICIO."
                                   Foreground="#ffffff"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="La licencia está ligada al hardware (HWID) del equipo. No se puede activar en un equipo diferente al que opera el servicio."
                                   Foreground="#ffe0e0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="HWID"
                           Foreground="#aaaaaa"
                           Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="HwidTextBox"
                             IsReadOnly="True"
                             Text="{Binding FullHwid}"
                             TextWrapping="Wrap"
                             MinHeight="72"
                             VerticalContentAlignment="Center"
                             Margin="0,0,10,0"/>
                    <ui:Button x:Name="CopyButton"
                               Grid.Column="1"
                               Content="Copiar"
                               Appearance="Primary"
                               Click="CopyButton_Click"/>
                </Grid>

                <TextBlock Text="Solicitud de activación"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,18,0,8"/>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Clínica / Hospital"
                               Foreground="#aaaaaa"
                               Margin="0,0,0,4"/>
                    <TextBox Text="{Binding ClinicName, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="32"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Nombre del solicitante"
                               Foreground="#aaaaaa"
                               Margin="0,0,0,4"/>
                    <TextBox Text="{Binding RequesterName, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="32"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Contacto (opcional)"
                               Foreground="#aaaaaa"
                               Margin="0,0,0,4"/>
                    <TextBox Text="{Binding RequesterEmail, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="32"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Teléfono"
                               Foreground="#aaaaaa"
                               Margin="0,0,0,4"/>
                    <TextBox Text="{Binding ContactPhone, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="32"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Cantidad de licencias"
                               Foreground="#aaaaaa"
                               Margin="0,0,0,4"/>
                    <ComboBox SelectedValue="{Binding RequestedLicenses, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Tag"
                              MinHeight="32"
                              Margin="0,0,0,0">
                        <ComboBoxItem Tag="1" Content="1"/>
                        <ComboBoxItem Tag="2" Content="2"/>
                        <ComboBoxItem Tag="3" Content="3"/>
                        <ComboBoxItem Tag="4" Content="4"/>
                        <ComboBoxItem Tag="5" Content="5"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,14">
                    <ui:Button x:Name="CheckStatusButton"
                               Content="Verificar estado"
                               Appearance="Secondary"
                               Margin="0,0,10,0"
                               Click="CheckStatusButton_Click"/>
                    <ui:Button x:Name="SendButton"
                               Content="Enviar solicitud"
                               Appearance="Primary"
                               Click="SendButton_Click"/>
                </StackPanel>

                <TextBlock Text="{Binding ExpiresAtDisplay}"
                           Foreground="#888899"
                           FontSize="12"
                           Margin="0,0,0,16"/>

                <Border x:Name="DropZone"
                        BorderBrush="#4a9eff"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="24"
                        Margin="0,24,0,0"
                        Background="#24243a">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="Document24"
                                       Foreground="#4a9eff"
                                       FontSize="34"
                                       HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DropText"
                                   Text="Arrastra aqui tu archivo .key para activarla"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   Margin="0,10,0,0"/>
                        <TextBlock x:Name="DropHintText"
                                   Text="Tambien puedes seleccionarlo manualmente."
                                   Foreground="#888899"
                                   TextAlignment="Center"
                                   Margin="0,4,0,0"/>
                        <ui:Button x:Name="BrowseButton"
                                   Content="Seleccionar .key"
                                   HorizontalAlignment="Center"
                                   Margin="0,14,0,0"
                                   Click="BrowseButton_Click"/>
                        <ui:Button x:Name="ActivateReceivedButton"
                                   Content="Activar licencia recibida"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"
                                   Click="ActivateReceivedButton_Click"
                                   IsEnabled="{Binding CanActivateReceivedLicense}"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusText"
                           Foreground="#ffb86b"
                           TextWrapping="Wrap"
                           Margin="0,18,0,0"
                           Text="{Binding StatusMessage}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
