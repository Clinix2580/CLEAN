<Page x:Class="OS.Presentation.UI.Views.PatientsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Patients">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock x:Name="HeaderText" 
                      Text="Patients" 
                      FontSize="28" 
                      FontWeight="Bold"
                      VerticalAlignment="Center"/>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:TextBox x:Name="SearchBox" 
                           Width="250" 
                           PlaceholderText="Search patients..."
                           Margin="0,0,10,0"/>
                <ui:Button x:Name="AddButton" 
                            Content="Add Patient" 
                            Appearance="Primary"
                            Icon="Add24"
                            Click="AddButton_Click"/>
            </StackPanel>
        </Grid>
        
        <!-- Filters -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <ui:Button x:Name="AllButton" Content="All" Appearance="Primary" Margin="0,0,5,0"/>
            <ui:Button x:Name="ActiveButton" Content="Active" Margin="0,0,5,0"/>
            <ui:Button x:Name="BlockedButton" Content="Blocked" Margin="0,0,5,0"/>
        </StackPanel>
        
        <!-- Data Grid -->
        <ui:Card Grid.Row="2">
            <DataGrid x:Name="PatientsDataGrid"
                     AutoGenerateColumns="False"
                     IsReadOnly="True"
                     SelectionMode="Single"
                     GridLinesVisibility="Horizontal"
                     HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="ColName" Header="Name" Binding="{Binding FullName}" Width="200"/>
                    <DataGridTextColumn x:Name="ColMRN" Header="Medical Record #" Binding="{Binding MedicalRecordNumber}" Width="150"/>
                    <DataGridTextColumn x:Name="ColDOB" Header="Date of Birth" Binding="{Binding DateOfBirth, StringFormat=d}" Width="120"/>
                    <DataGridTextColumn x:Name="ColPhone" Header="Phone" Binding="{Binding Phone}" Width="150"/>
                    <DataGridCheckBoxColumn x:Name="ColBlocked" Header="Blocked" Binding="{Binding IsBlocked}" Width="80"/>
                    <DataGridTemplateColumn x:Name="ColActions" Header="Actions" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Appearance="Transparent" 
                                              Icon="Edit24" 
                                              Click="EditButton_Click"
                                              Tag="{Binding Id}"/>
                                    <ui:Button Appearance="Transparent" 
                                              Icon="Delete24" 
                                              Click="DeleteButton_Click"
                                              Tag="{Binding Id}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </ui:Card>
    </Grid>
</Page>
