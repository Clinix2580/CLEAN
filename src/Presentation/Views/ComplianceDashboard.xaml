<Window x:Class="OS.Presentation.Views.ComplianceDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OS.Presentation.ViewModels"
        mc:Ignorable="d"
        Title="Dashboard de Cumplimiento Normativo - ClinicOS"
        Height="800"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="StatusCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="2" Color="#CCCCCC" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="20" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#E0E0E0" />
        </Style>

        <Style x:Key="AlertListBoxStyle" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <DataTemplate x:Key="AlertTemplate" DataType="local:ComplianceAlert">
            <Border Background="#F8F8F8" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Margin="0,2">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="12" Height="12" Fill="{Binding SeverityColor}" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Message}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Timestamp, StringFormat=HH:mm:ss}" Foreground="#666" FontSize="10" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Dashboard de Cumplimiento Normativo"
                             FontSize="24" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Monitoreo en tiempo real de HIPAA y LFPDPPP"
                             FontSize="14" Foreground="#B0B0B0" Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding OverallStatus}"
                             FontSize="18" FontWeight="Bold" Foreground="{Binding OverallStatusColor}" />
                    <TextBlock Text="{Binding LastUpdate, StringFormat='Última actualización: \{0:HH:mm:ss\}'}"
                             Foreground="#B0B0B0" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- HIPAA Section -->
            <Border Grid.Column="0" Style="{StaticResource StatusCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="🏥" FontSize="24" Margin="0,0,10,0" />
                        <StackPanel>
                            <TextBlock Text="HIPAA Compliance"
                                     FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="{Binding HipaaStatus}"
                                     FontSize="14" Foreground="{Binding HipaaStatusColor}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" Value="{Binding HipaaComplianceScore}"
                                   Style="{StaticResource ProgressBarStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding HipaaComplianceScore, StringFormat=\{0:F1\}%}"
                                 Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Bold" />
                    </Grid>

                    <TextBlock Grid.Row="2" Text="{Binding HipaaLastCheck, StringFormat='Última verificación: \{0\}'}"
                             Foreground="#666" FontSize="12" Margin="0,0,0,10" />

                    <GroupBox Grid.Row="3" Header="Alertas Recientes" FontWeight="Bold">
                        <ListBox ItemsSource="{Binding HipaaAlerts}"
                                ItemTemplate="{StaticResource AlertTemplate}"
                                Style="{StaticResource AlertListBoxStyle}"
                                MaxHeight="200" />
                    </GroupBox>
                </Grid>
            </Border>

            <!-- LFPDPPP Section -->
            <Border Grid.Column="1" Style="{StaticResource StatusCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="🇲🇽" FontSize="24" Margin="0,0,10,0" />
                        <StackPanel>
                            <TextBlock Text="LFPDPPP Compliance"
                                     FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="{Binding LfpdpppStatus}"
                                     FontSize="14" Foreground="{Binding LfpdpppStatusColor}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" Value="{Binding LfpdpppComplianceScore}"
                                   Style="{StaticResource ProgressBarStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding LfpdpppComplianceScore, StringFormat=\{0:F1\}%}"
                                 Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Bold" />
                    </Grid>

                    <TextBlock Grid.Row="2" Text="{Binding LfpdpppLastCheck, StringFormat='Última verificación: \{0\}'}"
                             Foreground="#666" FontSize="12" Margin="0,0,0,10" />

                    <GroupBox Grid.Row="3" Header="Alertas Recientes" FontWeight="Bold">
                        <ListBox ItemsSource="{Binding LfpdpppAlerts}"
                                ItemTemplate="{StaticResource AlertTemplate}"
                                Style="{StaticResource AlertListBoxStyle}"
                                MaxHeight="200" />
                    </GroupBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#34495E" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="ClinicOS - Sistema de Cumplimiento Normativo"
                         Foreground="#B0B0B0" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔄 Actualización automática cada 30 segundos"
                             Foreground="#B0B0B0" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
