<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <AssemblyName>OS.Infrastructure</AssemblyName>
    <RootNamespace>OS.Infrastructure</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <Nullable>enable</Nullable>
    <NoWarn>IL2026;IL2091;IL2095;IL3050;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Stage 1: keep incomplete web/PostgreSQL multi-tenant prototype out of the offline WPF runtime build. -->
    <Compile Remove="Data\MultiTenantApplicationDbContext.cs" />
    <Compile Remove="MultiTenancy\TenantMiddleware.cs" />
    <Compile Remove="MultiTenantInfrastructureServiceCollectionExtensions.cs" />
    <Compile Remove="Repositories\Repository.cs" />
    <Compile Remove="RepositoryServiceCollectionExtensions.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Application\OS.Application.csproj" />
    <ProjectReference Include="..\Core\Domain\OS.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Application\Services\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\tools\pgsql-portable\**\*">
      <Link>Database\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Entity Framework Core -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    
    <!-- Security -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    
    <!-- Logging -->
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="2.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    
    <!-- IoC -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
  </ItemGroup>
</Project>
